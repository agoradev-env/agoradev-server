# Server Configuration
PORT=3001
HOST=0.0.0.0

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:3000,https://yourdomain.com)
# Do not use wildcard (*) with credentials: true
CORS_ORIGIN=http://localhost:3000

# Supabase Configuration
# Replace with your actual Supabase project credentials
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# JWT Configuration
# Generate a secure random key with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Swagger Documentation Configuration
# Set to 'true' to enable Swagger documentation (disable in production)
SWAGGER_ENABLED=true
# Required when SWAGGER_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=change_this_password_in_production
